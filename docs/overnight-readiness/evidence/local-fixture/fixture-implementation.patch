+def area(width, height):
+    if width < 0 or height < 0:
+        raise ValueError("negative dimension")
+    return width * height
diff --git a/architectural/envelope/test_area.py b/architectural/envelope/test_area.py
new file mode 100644
index 0000000..f08ef01
--- /dev/null
+++ b/architectural/envelope/test_area.py
@@ -0,0 +1,8 @@
+import unittest
+from area import area
+class AreaTest(unittest.TestCase):
+    def test_positive(self): self.assertEqual(area(2,3),6)
+    def test_negative(self):
+        with self.assertRaises(ValueError): area(-1,2)
+    def test_negative_height(self):
+        with self.assertRaises(ValueError): area(2,-1)
